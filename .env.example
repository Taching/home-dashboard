# Copy this file to .env on the Raspberry Pi. Never commit the real file.
TZ=Asia/Tokyo

# Outdoor weather (Open-Meteo). Minato ward, Tokyo.
WEATHER_LATITUDE=35.6581
WEATHER_LONGITUDE=139.7514
WEATHER_LOCATION_NAME=Minato, Tokyo

SENSOR_POLL_INTERVAL_SECONDS=300
SENSOR_ENABLED=true
SENSOR_I2C_ADDRESS=68

# BroadLink RM4 Mini (IR only). Discover the values on the Pi, then learn
# light ON/OFF packets with `docker compose run --rm backend python -m app.tools.learn_broadlink`.
BROADLINK_HOST=
BROADLINK_MAC=
# Use the exact ID reported by app.tools.discover_broadlink. It differs by RM4 Mini revision.
BROADLINK_DEVICE_TYPE=
BROADLINK_CODES_PATH=/data/learned-codes/lights.json
SCREEN_ON_HOUR=10
SCREEN_OFF_HOUR=19

# Used by Chili's calendar-adjust and coach AI calls (backend/app/domain/training/adjust.py,
# training/llm.py, training/review.py) — required for those, not just voice.
OPENAI_API_KEY=
VOICE_COMMAND_MODEL=gpt-5-mini
PI_VOLUME_CARD=0
PI_VOLUME_CONTROL=PCM
PI_VOLUME_STEP_PERCENT=10

# Spotify now-playing (server-side OAuth)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/v1/spotify/callback

# Apple Calendar bridge. Use a long random value; it authenticates the Mac helper.
APPLE_CALENDAR_BRIDGE_TOKEN=
CALENDAR_BRIDGE_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1

# Notion tasks. Share the task database/data source with your Notion integration.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_DUE_PROPERTY=Due Date
NOTION_DONE_PROPERTY=Done
NOTION_STATUS_PROPERTY=Status
NOTION_DONE_STATUSES=Done,Complete,Completed

# OpenClaw shared main session. The token is backend-only; never expose it to React.
OPENCLAW_GATEWAY_WS_URL=ws://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_SESSION_KEY=agent:main:main
OPENCLAW_NOTIFY_CHANNEL=telegram
OPENCLAW_NOTIFY_TARGET=

# SwitchBot plant pump (Cloud Open API). Tap SwitchBot app version 10x in Profile
# > About to reveal Developer Options, then copy token + secret. Discover device IDs with:
# docker compose -f compose.yaml -f compose.pi.yaml run --rm backend python -m app.tools.discover_switchbot
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_PLUG_DEVICE_ID=
WATER_PUMP_DURATION_SECONDS=20

# Shared secret for OpenClaw/cron to trigger POST /api/v1/automation/water,
# POST /api/v1/automation/walkingpad/log, POST /api/v1/automation/training/log,
# and GET /api/v1/db/{YYYY-MM-DD}
DASHBOARD_AUTOMATION_TOKEN=

# Public URL used in OpenClaw / calendar workout links (Tailscale or LAN).
CHILI_PUBLIC_URL=https://chili-dashboard.tail95606b.ts.net
DAILY_BRIEFING_BASE_URL=https://chili-dashboard.tail95606b.ts.net
NOTION_PROGRESS_DATA_SOURCE_ID=
NOTION_TRAINING_DATA_SOURCE_ID=
TRAINING_ENABLED=true
TRAINING_CALENDAR_NAME=Chili Training
SOBER_BASELINE_DATE=2026-08-22
SOBER_BASELINE_DAYS=7
WEIGHT_GOAL_KG=74

# WalkingPad S1 BLE collector (KingSmith). Find the BLE name with: bluetoothctl scan on
WALKINGPAD_BLE_NAME=
WALKINGPAD_BRIDGE_TOKEN=
WALKINGPAD_GOAL_MINUTES=120
WALKINGPAD_GOAL_DISTANCE_KM=3.0
WALKINGPAD_REMINDER_START_HOUR=10
WALKINGPAD_REMINDER_END_HOUR=20
WALKINGPAD_MIN_GAP_BEFORE_MEETING_MIN=60
WALKINGPAD_MIN_SESSION_MINUTES=15
